generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
}

// A client company that has bought the WhatsApp AI agent product.
model Business {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Meta Cloud API connection for this business's WhatsApp number.
  wabaPhoneNumberId String? @unique
  wabaAccessToken   String? // AES-256-GCM encrypted, see lib/crypto.ts

  // What kind of business this is, so the AI agent can tailor its answers
  // (e.g. "clinica" vs "ecommerce" call for very different context).
  industry String @default("otro")

  // Determines the monthly active-contacts limit shown on the dashboard
  // (see src/lib/plans.ts). Assigned by the agency after a sales call — not
  // self-service, no billing integration wired to it yet, so this is purely
  // informational: reaching the cap never blocks the agent from replying.
  planTier PlanTier @default(STARTER)

  memberships    Membership[]
  agent          AIAgent?
  conversations  Conversation[]
  pipelineStages PipelineStage[]
}

enum PlanTier {
  STARTER
  PRO
  SCALE
}

// Links a platform user to a business (a user can manage multiple businesses).
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String?
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

model Membership {
  id         String   @id @default(cuid())
  role       Role     @default(OWNER)
  userId     String
  businessId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
}

// Configuration for the AI agent that replies on behalf of a business.
model AIAgent {
  id           String   @id @default(cuid())
  businessId   String   @unique
  systemPrompt String   @db.Text
  model        String   @default("claude-sonnet-5")
  enabled      Boolean  @default(true)
  tone         String   @default("cercano")
  replyLength  String   @default("breve")
  updatedAt    DateTime @updatedAt

  // Latest AI-generated sales coaching report (see src/lib/diagnosis.ts) —
  // regenerated on demand from a button in the dashboard, not on a schedule.
  // Nullable: no report exists until the business owner generates one.
  diagnosisReport      Json?
  diagnosisGeneratedAt DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// A CRM pipeline stage, owned by one business and fully customizable: each
// business gets its own set of stages (seeded with 5 defaults on creation),
// and can rename, add, delete, or reorder them independently of every other
// business.
model PipelineStage {
  id         String   @id @default(cuid())
  businessId String
  name       String
  position   Int
  createdAt  DateTime @default(now())

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([businessId, position])
}

// One WhatsApp conversation thread with an end customer of a business.
model Conversation {
  id             String   @id @default(cuid())
  businessId     String
  customerPhone  String
  customerName   String?
  stageId        String
  // When true, the AI agent stays silent on new messages in this specific
  // conversation — for when the business owner wants to take over one chat
  // by hand without touching the agent for everyone else.
  aiPaused       Boolean  @default(false)
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stage    PipelineStage @relation(fields: [stageId], references: [id])
  messages Message[]

  @@unique([businessId, customerPhone])
  @@index([stageId])
}

enum MessageRole {
  CUSTOMER
  AGENT
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  whatsappMsgId  String?
  sentByHuman    Boolean     @default(false)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
