generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  // A teammate the OWNER invited into their own business (e.g. a
  // salesperson) — see inviteTeamMember in lib/actions.ts. Restricted on
  // purpose: full CRM access (conversations, their own embudo/pipeline,
  // broadcasts) but no WhatsApp credentials, no AI agent configuration, no
  // billing/plan, and can't delete the business or manage the team — see
  // requireBusinessOwnerOrAdmin in lib/authz.ts for what's gated.
  MEMBER
}

// A client company that has bought the WhatsApp AI agent product.
model Business {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Meta Cloud API connection for this business's WhatsApp number.
  wabaPhoneNumberId String? @unique
  wabaAccessToken   String? // AES-256-GCM encrypted, see lib/crypto.ts
  // WhatsApp Business Account id — a different id than wabaPhoneNumberId,
  // needed only for message-template management (Meta scopes templates to
  // the WABA, not the phone number). Not secret, so not encrypted, same as
  // wabaPhoneNumberId.
  wabaId            String?

  // What kind of business this is, so the AI agent can tailor its answers
  // (e.g. "clinica" vs "ecommerce" call for very different context).
  industry String @default("otro")

  // Determines the monthly active-contacts limit shown on the dashboard
  // (see src/lib/plans.ts). Assigned by the agency after a sales call — not
  // self-service, no billing integration wired to it yet, so this is purely
  // informational: reaching the cap never blocks the agent from replying.
  planTier            PlanTier @default(STARTER)
  // Brand colors (hex), set from the website creation studio. The page
  // generator uses them as the page's accent so every new page looks like
  // the business, not like a random palette.
  brandPrimaryColor   String?
  brandSecondaryColor String?

  // Current paid-period window — set manually by the agency (ADMIN) from
  // /dashboard/clients whenever they confirm a Hotmart payment, since
  // there's no billing integration to derive this from. Both nullable:
  // unset until the agency records the first payment. Purely informational,
  // like planTier above — an expired subscriptionEndsAt never blocks the
  // agent from replying, it's just a signal for the agency to follow up.
  subscriptionStartedAt DateTime?
  subscriptionEndsAt    DateTime?

  // WhatsApp connection health (see lib/whatsappHealth.ts). lastWebhookAt:
  // last time Meta delivered ANY event (message or delivery receipt) for
  // this number — if customers write and this doesn't move, Meta isn't
  // sending us anything. webhookError*: last failure while receiving
  // (bad signature, processing crash). whatsappHealth*: result of the last
  // connection check (token, phone id, webhook subscription), so an alert
  // is sent only when it goes from OK to broken, not every day.
  lastWebhookAt           DateTime?
  // Throttle for the opportunistic "retry unanswered chats" sweep that
  // piggybacks on webhook deliveries and dashboard polling.
  lastReplySweepAt        DateTime?
  webhookError            String?
  webhookErrorAt          DateTime?
  whatsappHealthOk        Boolean?
  whatsappHealthMessage   String?
  whatsappHealthCheckedAt DateTime?

  memberships      Membership[]
  agent            AIAgent?
  conversations    Conversation[]
  pipelineStages   PipelineStage[]
  pipelines        Pipeline[]
  broadcasts       Broadcast[]
  messageTemplates MessageTemplate[]
  websites         Website[]
  agentMedia       AgentMedia[]
  sales            Sale[]
  products         Product[]
  aiUsage          AiUsage[]
  notifications    Notification[]
}

// A photo or document (product shot, PDF catalog, etc.) the client uploads
// once so the AI agent can decide, mid-conversation, to send it to a
// customer — see lib/ai.ts's "send_media" tool and lib/agent.ts's handling
// of it. `label` is what the AI actually reads to know what the file is and
// when sending it makes sense — kept short and descriptive on purpose
// ("Catálogo de productos", "Foto silla azul"), not a filename.
model AgentMedia {
  id         String   @id @default(cuid())
  businessId String
  url        String
  mediaType  String // "image" | "document" — the only two types offered here
  filename   String?
  label      String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// The business's product catalog — what the "tienda" and "producto" page
// types render (see lib/websiteContentV2.ts). The AI never invents
// products or prices; it can only pick from these.
model Product {
  id             String   @id @default(cuid())
  businessId     String
  name           String
  description    String   @default("")
  // Whole pesos (or the business's currency units) — no cents needed.
  price          Int?
  compareAtPrice Int?
  currency       String   @default("COP")
  category       String?
  imageUrl       String?
  // Short label shown on the card, e.g. "Nuevo", "Más vendido", "-20%".
  badge          String?
  active         Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, active, position])
}

enum PlanTier {
  STARTER
  PRO
  SCALE
}

// Links a platform user to a business (a user can manage multiple businesses).
model User {
  id                String             @id @default(cuid())
  email             String             @unique
  // Contact/WhatsApp number for the agency to reach this person directly —
  // separate from wabaPhoneNumberId on Business, which is the Meta WhatsApp
  // Business API config for their bot, not a way to contact them.
  phone             String?
  // Fed into the AI agent's system prompt as background context (see
  // buildSystemPrompt in src/lib/ai.ts) so the bot can answer "¿dónde
  // están?" or share a social media handle without the client having to
  // type it into their own editable prompt — set once here, used by every
  // business this account owns.
  city              String?
  country           String?
  facebook          String?
  instagram         String?
  tiktok            String?
  linkedin          String?
  passwordHash      String
  name              String?
  createdAt         DateTime           @default(now())
  memberships       Membership[]
  addons            AccountAddon[]
  pushSubscriptions PushSubscription[]

  // Password reset flow: resetTokenHash stores a SHA-256 hash of the token
  // emailed to the user (never the raw token) so a DB read alone can't be
  // used to reset a password; resetTokenExpiresAt bounds how long it's
  // valid. Both cleared once used.
  // What this account actually pays per month in USD, when it differs from
  // the plan's list price (launch offer, negotiated deal). Null = list price
  // (PLAN_PRICE_USD in lib/plans.ts). Only used by the agency's Rentabilidad
  // page.
  monthlyPriceUsd     Float?
  // Self-registered accounts must register a card in Mercado Pago (free
  // trial) before using the dashboard — see app/activar. Cleared when the
  // subscription is authorized (lib/payments.ts). Accounts created by the
  // agency or by a payment never need it.
  activationRequired  Boolean   @default(false)
  // The Mercado Pago subscription that pays for this account, once known.
  // Subscriptions started from the trial plan's checkout carry no id of
  // ours, so this is how renewals find the account (see lib/trial.ts).
  mpPreapprovalId     String?   @unique
  // When they last went to Mercado Pago from /activar: lets a subscription
  // that arrives with an unknown email be matched to the one person who
  // was checking out at that moment.
  trialCheckoutAt     DateTime?
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
}

model Membership {
  id         String   @id @default(cuid())
  role       Role     @default(OWNER)
  userId     String
  businessId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
}

// Configuration for the AI agent that replies on behalf of a business.
model AIAgent {
  id           String   @id @default(cuid())
  businessId   String   @unique
  systemPrompt String   @db.Text
  model        String   @default("claude-sonnet-5")
  enabled      Boolean  @default(true)
  tone         String   @default("cercano")
  replyLength  String   @default("breve")
  updatedAt    DateTime @updatedAt

  // Latest AI-generated sales coaching report (see src/lib/diagnosis.ts) —
  // regenerated on demand from a button in the dashboard, not on a schedule.
  // Nullable: no report exists until the business owner generates one.
  diagnosisReport      Json?
  diagnosisGeneratedAt DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// A business's own funnels — e.g. one per salesperson, all working the same
// shared WhatsApp number but each with their own board of leads. Every
// business always has at least one (isDefault, auto-created on signup); a
// brand-new inbound conversation always lands in the default pipeline's
// first stage (see lib/agent.ts) — a team member then claims it into their
// own funnel by moving it to one of their stages (see PipelineStage below).
model Pipeline {
  id         String   @id @default(cuid())
  businessId String
  name       String
  position   Int
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  professionals Professional[]

  @@unique([businessId, position])
}

// A CRM pipeline stage, owned by one pipeline (funnel) and fully
// customizable: each pipeline gets its own set of stages (seeded with 5
// defaults when the pipeline is created), and can rename, add, delete, or
// reorder them independently of every other pipeline. `businessId` is kept
// alongside `pipelineId` (denormalized on purpose) so views that show every
// stage across every funnel at once — the single-conversation stage picker,
// the KPI stage-distribution chart — don't need an extra join.
model PipelineStage {
  id         String   @id @default(cuid())
  businessId String
  pipelineId String
  name       String
  position   Int
  createdAt  DateTime @default(now())

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pipeline      Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([pipelineId, position])
}

// One WhatsApp conversation thread with an end customer of a business.
model Conversation {
  id                 String    @id @default(cuid())
  businessId         String
  customerPhone      String
  customerName       String?
  // Optional contact data the business owner fills in by hand (lead panel,
  // "Agregar contacto") or brings in via CSV import — WhatsApp only ever
  // gives us the phone and a profile name.
  customerEmail      String?
  stageId            String
  // When true, the AI agent stays silent on new messages in this specific
  // conversation — for when the business owner wants to take over one chat
  // by hand without touching the agent for everyone else.
  aiPaused           Boolean   @default(false)
  lastMessageAt      DateTime  @default(now())
  // Automatic reply retries (see lib/replyRecovery.ts): how many times in a
  // row the AI reply to this conversation's latest customer message failed
  // or wasn't delivered, and when the last attempt started (so two runs
  // never retry the same conversation at once). Reset on a delivered reply.
  replyAttempts      Int       @default(0)
  lastReplyAttemptAt DateTime?
  createdAt          DateTime  @default(now())
  // Null = nobody on the team has opened this conversation yet, so every
  // customer message counts as unread (see crm/page.tsx, which bumps this
  // to now() whenever someone opens the chat) — powers the WhatsApp-style
  // unread badge/highlight on the conversation list.
  lastReadAt         DateTime?

  // Freeform labels the business/agency sets on this lead (e.g. "Empresa",
  // "Cotización") — shown as chips in the lead detail panel. Not tied to
  // pipeline stage, which already tracks funnel position on its own.
  tags            String[]  @default([])
  // Manually-set summary of the lead shown in the detail panel — e.g. what
  // the AI agent picked up on, or a note the business owner typed in.
  notes           String?   @db.Text
  // Set either by hand from the detail panel (see updateConversationDetails
  // in lib/actions.ts) or automatically by the AI agent when it detects the
  // customer confirming a concrete date/time in the chat itself (see the
  // mark_appointment tool in lib/ai.ts and lib/agent.ts) — a Notification
  // row is created alongside an automatic update. Still no live sync from
  // the separate agenda.funnelslabs.app booking project.
  appointmentAt   DateTime?
  appointmentNote String?

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stage           PipelineStage    @relation(fields: [stageId], references: [id])
  messages        Message[]
  notifications   Notification[]
  broadcastClicks BroadcastClick[]
  sales           Sale[]

  @@unique([businessId, customerPhone])
  @@index([stageId])
  // The CRM's conversation list (every tab: chat/board/list) always queries
  // by businessId ordered by lastMessageAt — without this, that query falls
  // back to the (businessId, customerPhone) unique index's leading column
  // only, so ordering isn't index-backed and gets slower as each business's
  // conversation history grows.
  @@index([businessId, lastMessageAt])
}

// Surfaced in the dashboard header's notification bell (see NotificationBell)
// — created automatically either when the AI agent detects a lead
// confirming a concrete appointment (mark_appointment tool in lib/ai.ts,
// handled in lib/agent.ts; conversationId set) or by the daily metric-alert
// job (lib/metricAlerts.ts, run from api/cron/metric-alerts; no single
// conversation to point to, so conversationId is null there). `type` is a
// plain string, not an enum, so new alert kinds don't need a migration.
model Notification {
  id             String    @id @default(cuid())
  businessId     String
  conversationId String?
  type           String
  message        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([businessId, readAt])
}

enum MessageRole {
  CUSTOMER
  AGENT
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  whatsappMsgId  String?
  sentByHuman    Boolean     @default(false)
  createdAt      DateTime    @default(now())

  // Real Anthropic API usage for this reply, captured from response.usage
  // at generation time — only set on AGENT messages that came from an
  // actual model call (never on human replies or the [ERROR INTERNO] /
  // [LÍMITE DE PLAN] system notices). Lets lib/aiCost.ts compute real spend
  // instead of the estimated figures used before any traffic existed.
  // `model` is stored per-message (not read from AIAgent.model at query
  // time) so cost stays accurate even if a business changes models later.
  model                    String?
  inputTokens              Int?
  outputTokens             Int?
  cacheCreationInputTokens Int?
  cacheReadInputTokens     Int?

  // Set when this message carries an attachment (image/audio/document/video)
  // instead of, or alongside, `content` as a caption. `mediaUrl` always
  // points at OUR OWN storage (see lib/attachments.ts) — never a raw Meta
  // media URL, since those expire after a few minutes, so an inbound
  // attachment is downloaded and re-uploaded immediately in the webhook
  // handler before this row is written.
  mediaUrl       String?
  mediaType      String? // "image" | "audio" | "document" | "video"
  mediaMimeType  String?
  mediaFilename  String?
  mediaSizeBytes Int?

  // Set only on a message created by lib/actions.ts's sendBroadcast — lets a
  // Broadcast's KPI view (see BroadcastHistory.tsx) roll up delivery/read
  // stats for exactly the messages it sent, without guessing from timing.
  broadcastId String?

  // Meta's async delivery receipt for THIS message (matched back by
  // whatsappMsgId — see lib/deliveryTracking.ts, fed by the "statuses"
  // array in the WhatsApp webhook). Null until the first receipt arrives;
  // "sent" itself is also a receipt (API acceptance is separate — see
  // Broadcast.sentCount). Covers every outbound message, not just
  // broadcasts, so the same tracking works for AI/human replies too.
  deliveryStatus   String? // "sent" | "delivered" | "read" | "failed"
  deliveryStatusAt DateTime?
  deliveryError    String?   @db.Text

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  broadcast    Broadcast?   @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([whatsappMsgId])
  @@index([broadcastId])
}

// An AI-generated marketing page for a business — served publicly at
// /sitio/[slug] (see app/sitio/[slug]/route.ts) and, once DNS is wired up
// the same way agente.funnelslabs.app was, at a real subdomain or the
// client's own domain. A business can have MANY of these (its own mini
// funnel — a main site plus purpose-built pages like a demo-booking page —
// mirroring how Funnels Labs' own funnel is funnelslabs.app + a dedicated
// agenda/diagnóstico page), not just one.
model Website {
  id         String @id @default(cuid())
  businessId String

  // "landing" (default): an AI-generated content page, rendered from
  // `content` by lib/websiteTemplate.ts. "agenda": a real booking-calendar
  // page instead — no AI content, rendered from its linked AgendaConfig by
  // lib/agendaTemplate.ts. Lets a business chain pages into a funnel (an
  // offer page whose button points at its own agenda page's URL) entirely
  // within this app, no external scheduling tool required.
  pageType String @default("landing")

  // Ad tracking the client adds to run campaigns to this page: their Meta
  // Pixel id (digits) and Google tag id (G-…/AW-…). Only validated ids are
  // stored and the page injects the standard snippets itself (see
  // lib/siteTracking.ts) — never free-form code.
  metaPixelId String?
  googleTagId String?

  // Client-facing label to tell pages apart in the list, e.g. "Sitio
  // principal", "Página para agendar demo".
  name String

  // What this specific page is for — fed into the generation prompt (see
  // lib/websiteGenerator.ts) so its copy and call-to-action match, e.g.
  // "que el visitante agende una demo" vs "presentar el negocio en general".
  // Stored (not just used once) so regenerating this page reuses the same
  // intent instead of losing it.
  purpose String?

  // The client's own free-text brief for how they want this page to look
  // and read ("quiero algo minimalista, en tonos verdes, que hable de
  // nuestros 10 años de experiencia...") — fed into the generation prompt
  // (see lib/websiteGenerator.ts) with priority over the generic per-
  // industry defaults. Stored (not just used once) so "Regenerar todo con
  // IA" reuses the same brief instead of losing it, same as `purpose`.
  designPrompt String?

  // Human-readable, derived from the business + page name — this stays
  // clean so people can recognize/search the site, with a short numeric
  // suffix appended only on an actual collision.
  slug String @unique

  // Structured, editable copy + theme (see lib/websiteContent.ts for the
  // zod schema) — the public page is rendered from this on every request
  // (see app/sitio/[slug]/route.ts), so an edit here is live immediately,
  // no separate "publish" step and no stale cached HTML to fall out of sync.
  content Json

  // One AI-generated photo for this page's hero, made once at creation or
  // full "Regenerar todo" time (see lib/websiteHeroImage.ts) — never
  // regenerated by a small AI text edit, to keep image-generation cost
  // bounded. Only used as a fallback when the business hasn't uploaded its
  // own photo (see getWebsiteHeroContext in lib/websiteHero.ts, which
  // always prefers a real AgentMedia upload over this).
  aiImageUrl String?

  // Resolved from the business's WhatsApp credentials at generation time
  // (see fetchWhatsAppDisplayNumber) and snapshotted here rather than
  // re-fetched on every public page view — cheaper, faster, and doesn't
  // depend on the access token staying valid for a page to load.
  whatsappNumber String

  model        String?
  customDomain String?  @unique
  generatedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  events       WebsiteEvent[]
  leads        WebsiteLead[]
  agendaConfig AgendaConfig?
  appointments Appointment[]

  @@index([businessId])
}

// One per agenda-type Website — its availability and where booking
// notifications go. Kept as its own table (instead of columns on Website)
// since it's meaningless for a "landing" page and this keeps that model
// from growing fields most pages never use.
model AgendaConfig {
  id        String @id @default(cuid())
  websiteId String @unique

  // Who gets emailed when someone books — defaults to the owner's own
  // login email at creation (see actions.ts's createAgendaPage), but kept
  // editable separately since a clinic might want bookings to go to a
  // front-desk inbox instead. The lead who books gets their own
  // confirmation email too (see lib/agenda.ts's bookAppointment) — this
  // field is only for the business side of that notification.
  notificationEmail String

  // IANA zone (e.g. "America/Bogota") — every slot is computed and shown
  // in this zone regardless of a visitor's own browser locale, since the
  // business's real-world hours are what matters for a booking.
  timezone String @default("America/Bogota")

  // Appointment length in minutes — also the spacing between slots
  // (see lib/agenda.ts's getAvailableSlotsForDate). No back-to-back
  // double-booking risk since slots are generated at exactly this
  // interval and checked against existing Appointments.
  slotMinutes Int @default(30)

  // Weekly recurring hours, one simple range per day (no split
  // lunch-break ranges in this first version — a real gap, but rare
  // enough for a v1 that it's a documented simplification rather than
  // silently wrong). Shape: { monday: { enabled, start: "09:00", end:
  // "17:00" }, ... } for all 7 days — see lib/agenda.ts's zod schema.
  availability Json

  // Accent color for the public booking page (see lib/agendaTemplate.ts)
  // — agenda pages have no AI-generated `theme` to draw from, so this is
  // the one visual choice the owner makes, defaulting to the same blue
  // used everywhere else a page has no chosen accent yet.
  primaryColor String @default("#1f6feb")

  website       Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  professionals Professional[]
}

// A staff member a visitor can pick to book with (e.g. "Dra. Gómez —
// Ortodoncista") — optional: an agenda with zero rows here behaves exactly
// like a single-provider business always has (AgendaConfig's own
// availability/notificationEmail, no picker step). Once at least one exists,
// the public page adds a "choose your professional" step before the day
// picker, and each one's own `availability` (same shape as
// AgendaConfig.availability) governs their bookable hours instead of the
// agenda-level one.
model Professional {
  id             String  @id @default(cuid())
  agendaConfigId String
  name           String
  title          String? // optional role/specialty shown to visitors, e.g. "Ortodoncista"
  email          String? // gets their own notification email when someone books with them
  availability   Json
  active         Boolean @default(true) // soft-hide from the picker without losing their appointment history
  position       Int     @default(0)
  // When set, a booking made with THIS professional routes the CRM
  // conversation into this pipeline's first stage instead of the business's
  // default one (see upsertLeadConversation) — lets each salesperson work
  // their own embudo. SetNull (not Cascade) so deleting a pipeline just
  // drops the assignment, never the professional or their appointment
  // history.
  pipelineId     String?

  createdAt DateTime @default(now())

  agendaConfig AgendaConfig  @relation(fields: [agendaConfigId], references: [id], onDelete: Cascade)
  pipeline     Pipeline?     @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([agendaConfigId])
  @@index([pipelineId])
}

// A confirmed booking made through an agenda-type Website's public page —
// see app/sitio/[slug]/reservar/route.ts. `startsAt` is always stored in
// UTC (converted from the visitor's selected wall-clock slot via
// lib/timezone.ts) so it sorts and compares correctly regardless of the
// business's configured timezone.
model Appointment {
  id             String   @id @default(cuid())
  websiteId      String
  // Null when the agenda has no Professionals at all (the common
  // single-provider case) or, in principle, a slot booked before this field
  // existed. Never null once the agenda has professionals — the public flow
  // requires picking one first.
  professionalId String?
  name           String
  contact        String // phone/WhatsApp, shown to the business
  email          String? // optional — only present when given, used for the visitor's own confirmation email
  startsAt       DateTime
  status         String   @default("confirmed") // "confirmed" | "cancelled"
  createdAt      DateTime @default(now())

  // Set once the "1 hour before" reminder (WhatsApp + email to the lead) has
  // gone out — see lib/agendaReminders.ts. Null means not sent yet, the only
  // state the reminder cron's WHERE clause looks for; never cleared once set.
  reminderSentAt DateTime?

  website      Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  // Database-enforced double-booking guard — but NOT expressed as a normal
  // Prisma @@unique: two different professionals must be allowed to hold the
  // same clock time, while the same professional (or, when there are no
  // professionals, the business as a whole) still can't be double-booked.
  // Postgres can only express "same slot, treating a null professional as
  // one shared bucket" with an expression index over
  // COALESCE(professionalId, ''), which Prisma's schema language can't
  // declare — so this constraint exists ONLY in
  // prisma/migrations/20260924100000_add_agenda_professionals/migration.sql,
  // not here. Don't add `prisma migrate dev`/`db push` on this model without
  // checking that index still exists afterwards.
  @@index([websiteId, professionalId, startsAt])
  @@index([status, reminderSentAt, startsAt])
}

// Someone who filled the page's own lead-capture form (name + WhatsApp/phone
// + optional message) — see app/sitio/[slug]/registro/route.ts and proxy.ts's
// "/registro" branch for the custom-domain path. Deliberately separate from
// WebsiteEvent: this is a person's real contact info, not an anonymous click.
// A click on the external agenda/booking link is still only tracked as a
// WebsiteEvent (destination "agenda") — that booking form lives outside this
// app, so its submissions aren't something this app can see or record here.
model WebsiteLead {
  id        String   @id @default(cuid())
  websiteId String
  name      String
  contact   String
  message   String?
  createdAt DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, createdAt])
}

// A page view or a click on one of the page's call-to-action buttons —
// logged by app/sitio/[slug]/route.ts and the /ir click-through redirect
// (see app/sitio/[slug]/ir/route.ts and proxy.ts for the custom-domain
// path), aggregated in the website editor. Deliberately minimal — no IP or
// user-agent capture, just enough to answer "is this page getting visits,
// and are people clicking through to WhatsApp/the agenda link."
model WebsiteEvent {
  id          String   @id @default(cuid())
  websiteId   String
  type        String // "view" | "cta_click"
  label       String? // which button, e.g. "hero" | "header" | "contact" — null for "view"
  // Where a cta_click actually sent the visitor — "whatsapp" or "agenda"
  // (any external ctaUrl override) — kept separate from `label` since the
  // client asked for these never to be combined into one "clicks" number.
  // Captured at click time from that page's content, not derived later, so
  // it stays correct even if the page's link setting changes afterward.
  destination String?
  createdAt   DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, type, createdAt])
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
}

// A WhatsApp message template, submitted to Meta for approval so it can be
// sent to a customer outside the normal 24h free-form messaging window
// (required for broadcasts to contacts who haven't written in recently).
// Meta owns the actual approval — this row mirrors their status, refreshed
// on demand (no template-status webhook wired up).
model MessageTemplate {
  id             String  @id @default(cuid())
  businessId     String
  name           String // Meta's template name: lowercase, underscores only
  language       String // e.g. "es", "es_CO", "en_US"
  category       String // "MARKETING" | "UTILITY"
  bodyText       String  @db.Text
  // Optional image shown above the body — stored here as our own hosted
  // (Vercel Blob) URL, used both to redisplay it in the UI and to fill in
  // the header when sending an approved template (see whatsapp.ts). Meta
  // itself needs a separately-uploaded "handle" at creation time, not this
  // URL — see uploadTemplateHeaderImage.
  headerImageUrl String? @db.Text
  // Up to 2 CTA/URL buttons: [{ type: "URL", text, url }, ...]
  buttons        Json?

  status          TemplateStatus @default(PENDING)
  metaTemplateId  String? // id Meta assigns once created
  rejectionReason String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name, language])
}

// One mass-send of a single message to every conversation in a business
// (optionally scoped to one pipeline stage). Meta only allows free-form
// messages to a customer within 24h of their last message — outside that
// window a send fails per-recipient rather than blocking the whole batch,
// which `failedCount`/`resultLog` surface back to whoever sent it.
model Broadcast {
  id              String    @id @default(cuid())
  businessId      String
  stageId         String? // null = every conversation in the business
  // Set when the broadcast went to a filtered selection from the CRM
  // (e.g. "Sin respuesta · #VIP") instead of a whole stage/pipeline.
  audienceLabel   String?
  message         String    @db.Text
  // Optional image/document attached to a free-form broadcast (see
  // sendBroadcast in lib/actions.ts) — not supported for template broadcasts,
  // since an approved Meta template's media header is a separate feature.
  mediaUrl        String?
  mediaType       String?
  mediaFilename   String?
  createdByUserId String
  totalRecipients Int
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  // Per-recipient outcome, e.g. [{"conversationId":"...","ok":false,"error":"..."}]
  resultLog       Json?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  // Optional link offered on the "Mensaje libre" send (not available for
  // template broadcasts, whose body is fixed by Meta) — when set, every
  // recipient's message carries a per-person tracked link instead of the
  // raw URL (see lib/broadcastTracking.ts's buildTrackedLink), so clicking
  // it can be attributed back to who clicked (see BroadcastClick below)
  // before redirecting to this real destination.
  ctaUrl     String? @db.Text
  clickCount Int     @default(0)

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages Message[]
  clicks   BroadcastClick[]

  @@index([businessId, createdAt])
}

// One person (conversation) clicking a broadcast's tracked link — see
// Broadcast.ctaUrl. Deduped per (broadcast, conversation): a second click by
// the same person doesn't add a second row, so "quién le dio clic" stays a
// clean list of distinct people, while Broadcast.clickCount (incremented on
// every visit, not deduped) is the raw total-clicks figure.
model BroadcastClick {
  id             String   @id @default(cuid())
  broadcastId    String
  conversationId String
  clickedAt      DateTime @default(now())

  broadcast    Broadcast    @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, conversationId])
  @@index([broadcastId])
}

// A generic "N events for this key in the last window" counter — used to
// rate-limit login attempts and password-reset requests (see auth.ts and
// actions.ts's requestPasswordReset) without adding an external dependency
// like Redis. Rows are cheap and short-lived; nothing prunes them yet since
// volume is low, but a cron sweep could delete rows older than the longest
// window in use if that ever becomes worth doing.
model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Platform-wide announcements the agency publishes to every client's Inicio
// page (see app/dashboard/page.tsx) and manages from /dashboard/novedades.
// BANNER = the big campaign-style hero at the top (only the first live one
// shows); NEWS = an entry in the "Novedades" list. Not tied to a business:
// it's the agency talking to all its clients at once.
model Announcement {
  id        String    @id @default(cuid())
  kind      String    @default("NEWS") // "BANNER" | "NEWS"
  title     String
  body      String    @db.Text
  badge     String? // short label, e.g. "Nuevo", "Promo"
  imageUrl  String?
  ctaLabel  String?
  ctaUrl    String?
  published Boolean   @default(false)
  // Optional live window — outside it the announcement is hidden even if published.
  startsAt  DateTime?
  endsAt    DateTime?
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([kind, published])
}

// Extra capacity bought on top of the plan (see lib/addons.ts): a pack of
// monthly contacts or an extra WhatsApp line, valid for 30 days from
// activation. Belongs to the account (the OWNER user), since plan limits
// are pooled per account across all its lines. PENDING rows are created
// when checkout starts; the Mercado Pago webhook flips them to ACTIVE (its
// id travels as the payment's external_reference), or the agency activates
// one by hand (source MANUAL).
model AccountAddon {
  id          String    @id @default(cuid())
  userId      String
  packKey     String
  kind        String // "CONTACTS" | "LINE"
  quantity    Int
  priceCop    Int
  status      String    @default("PENDING") // PENDING | ACTIVE | CANCELED
  source      String    @default("MERCADOPAGO") // MERCADOPAGO | MANUAL
  mpPaymentId String?   @unique
  activatedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
}

// AI spend that is NOT a WhatsApp reply (replies keep their token usage on
// Message itself): sales diagnoses, website generation/edits/creation chat,
// voice-note transcription and spoken replies, and generated images. One
// row per provider call, priced at write time (see lib/aiUsage.ts), so the
// agency's Rentabilidad page can show each client's full AI cost.
model AiUsage {
  id               String   @id @default(cuid())
  businessId       String
  kind             String // DIAGNOSIS | WEBSITE | VOICE_IN | VOICE_OUT | IMAGE
  provider         String // anthropic | openai
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheWriteTokens Int      @default(0)
  cacheReadTokens  Int      @default(0)
  // Non-token units for OpenAI audio: seconds transcribed / characters spoken.
  units            Float?
  costUsd          Float
  createdAt        DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([createdAt])
}

// Payment webhooks already applied (Hotmart sends several events per
// purchase — PURCHASE_APPROVED, then PURCHASE_COMPLETE after the guarantee
// period — and retries deliveries), so a payment extends a subscription
// exactly once. action: "grant" | "revoke".
model PaymentEvent {
  id          String   @id @default(cuid())
  provider    String
  transaction String
  action      String
  event       String
  email       String
  createdAt   DateTime @default(now())

  @@unique([provider, transaction, action])
}

// Small app-wide values the app manages itself (e.g. the id of the Mercado
// Pago trial plan it created), so they don't need a redeploy to change.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// A browser/phone that asked for push notifications (new chats, messages
// that need a person). One per device; dropped when the push service says
// it's gone (see lib/push.ts).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A closed sale, registered from the CRM (lead panel, or when a contact is
// moved to a "won" stage). Feeds the Ventas KPIs: revenue, ticket, close
// rate and how much the AI agent helped sell. Amounts are whole units of
// `currency` (COP by default), like Product.price.
model Sale {
  id              String   @id @default(cuid())
  businessId      String
  conversationId  String?
  productId       String?
  productName     String?
  amount          Int
  currency        String   @default("COP")
  note            String?
  // The AI agent had replied in this conversation before the sale closed.
  aiAssisted      Boolean  @default(false)
  closedAt        DateTime @default(now())
  createdByUserId String?
  createdAt       DateTime @default(now())

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([businessId, closedAt])
  @@index([conversationId])
}
