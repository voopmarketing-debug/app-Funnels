generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
}

// A client company that has bought the WhatsApp AI agent product.
model Business {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Meta Cloud API connection for this business's WhatsApp number.
  wabaPhoneNumberId String? @unique
  wabaAccessToken   String? // AES-256-GCM encrypted, see lib/crypto.ts

  // What kind of business this is, so the AI agent can tailor its answers
  // (e.g. "clinica" vs "ecommerce" call for very different context).
  industry String @default("otro")

  // Determines the monthly active-contacts limit shown on the dashboard
  // (see src/lib/plans.ts). Assigned by the agency after a sales call — not
  // self-service, no billing integration wired to it yet, so this is purely
  // informational: reaching the cap never blocks the agent from replying.
  planTier PlanTier @default(STARTER)

  // Current paid-period window — set manually by the agency (ADMIN) from
  // /dashboard/clients whenever they confirm a Hotmart payment, since
  // there's no billing integration to derive this from. Both nullable:
  // unset until the agency records the first payment. Purely informational,
  // like planTier above — an expired subscriptionEndsAt never blocks the
  // agent from replying, it's just a signal for the agency to follow up.
  subscriptionStartedAt DateTime?
  subscriptionEndsAt    DateTime?

  memberships    Membership[]
  agent          AIAgent?
  conversations  Conversation[]
  pipelineStages PipelineStage[]
  broadcasts     Broadcast[]
}

enum PlanTier {
  STARTER
  PRO
  SCALE
}

// Links a platform user to a business (a user can manage multiple businesses).
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  // Contact/WhatsApp number for the agency to reach this person directly —
  // separate from wabaPhoneNumberId on Business, which is the Meta WhatsApp
  // Business API config for their bot, not a way to contact them.
  phone        String?
  // Fed into the AI agent's system prompt as background context (see
  // buildSystemPrompt in src/lib/ai.ts) so the bot can answer "¿dónde
  // están?" or share a social media handle without the client having to
  // type it into their own editable prompt — set once here, used by every
  // business this account owns.
  city         String?
  country      String?
  facebook     String?
  instagram    String?
  tiktok       String?
  linkedin     String?
  passwordHash String
  name         String?
  createdAt    DateTime     @default(now())
  memberships  Membership[]

  // Password reset flow: resetTokenHash stores a SHA-256 hash of the token
  // emailed to the user (never the raw token) so a DB read alone can't be
  // used to reset a password; resetTokenExpiresAt bounds how long it's
  // valid. Both cleared once used.
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
}

model Membership {
  id         String   @id @default(cuid())
  role       Role     @default(OWNER)
  userId     String
  businessId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
}

// Configuration for the AI agent that replies on behalf of a business.
model AIAgent {
  id           String   @id @default(cuid())
  businessId   String   @unique
  systemPrompt String   @db.Text
  model        String   @default("claude-sonnet-5")
  enabled      Boolean  @default(true)
  tone         String   @default("cercano")
  replyLength  String   @default("breve")
  updatedAt    DateTime @updatedAt

  // Latest AI-generated sales coaching report (see src/lib/diagnosis.ts) —
  // regenerated on demand from a button in the dashboard, not on a schedule.
  // Nullable: no report exists until the business owner generates one.
  diagnosisReport      Json?
  diagnosisGeneratedAt DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// A CRM pipeline stage, owned by one business and fully customizable: each
// business gets its own set of stages (seeded with 5 defaults on creation),
// and can rename, add, delete, or reorder them independently of every other
// business.
model PipelineStage {
  id         String   @id @default(cuid())
  businessId String
  name       String
  position   Int
  createdAt  DateTime @default(now())

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([businessId, position])
}

// One WhatsApp conversation thread with an end customer of a business.
model Conversation {
  id             String   @id @default(cuid())
  businessId     String
  customerPhone  String
  customerName   String?
  stageId        String
  // When true, the AI agent stays silent on new messages in this specific
  // conversation — for when the business owner wants to take over one chat
  // by hand without touching the agent for everyone else.
  aiPaused       Boolean  @default(false)
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  // Freeform labels the business/agency sets on this lead (e.g. "Empresa",
  // "Cotización") — shown as chips in the lead detail panel. Not tied to
  // pipeline stage, which already tracks funnel position on its own.
  tags        String[] @default([])
  // Manually-set summary of the lead shown in the detail panel — e.g. what
  // the AI agent picked up on, or a note the business owner typed in.
  notes       String?  @db.Text
  // Manually recorded from the detail panel today (see updateConversationDetails
  // in lib/actions.ts) — there's no live sync yet from the separate
  // agenda.funnelslabs.app booking project, so this reflects what the
  // business owner/agency entered, not a real-time calendar feed.
  appointmentAt   DateTime?
  appointmentNote String?

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stage    PipelineStage @relation(fields: [stageId], references: [id])
  messages Message[]

  @@unique([businessId, customerPhone])
  @@index([stageId])
}

enum MessageRole {
  CUSTOMER
  AGENT
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  whatsappMsgId  String?
  sentByHuman    Boolean     @default(false)
  createdAt      DateTime    @default(now())

  // Real Anthropic API usage for this reply, captured from response.usage
  // at generation time — only set on AGENT messages that came from an
  // actual model call (never on human replies or the [ERROR INTERNO] /
  // [LÍMITE DE PLAN] system notices). Lets lib/aiCost.ts compute real spend
  // instead of the estimated figures used before any traffic existed.
  // `model` is stored per-message (not read from AIAgent.model at query
  // time) so cost stays accurate even if a business changes models later.
  model                    String?
  inputTokens              Int?
  outputTokens             Int?
  cacheCreationInputTokens Int?
  cacheReadInputTokens     Int?

  // Set when this message carries an attachment (image/audio/document/video)
  // instead of, or alongside, `content` as a caption. `mediaUrl` always
  // points at OUR OWN storage (see lib/attachments.ts) — never a raw Meta
  // media URL, since those expire after a few minutes, so an inbound
  // attachment is downloaded and re-uploaded immediately in the webhook
  // handler before this row is written.
  mediaUrl      String?
  mediaType     String? // "image" | "audio" | "document" | "video"
  mediaMimeType String?
  mediaFilename String?
  mediaSizeBytes Int?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// One mass-send of a single message to every conversation in a business
// (optionally scoped to one pipeline stage). Meta only allows free-form
// messages to a customer within 24h of their last message — outside that
// window a send fails per-recipient rather than blocking the whole batch,
// which `failedCount`/`resultLog` surface back to whoever sent it.
model Broadcast {
  id              String    @id @default(cuid())
  businessId      String
  stageId         String? // null = every conversation in the business
  message         String    @db.Text
  createdByUserId String
  totalRecipients Int
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  // Per-recipient outcome, e.g. [{"conversationId":"...","ok":false,"error":"..."}]
  resultLog       Json?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}
