# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/app_funnels"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# 32-byte (base64) key used to encrypt WhatsApp access tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# Meta app used to verify webhook signatures (App Dashboard > Settings > Basic > App Secret)
META_APP_SECRET="your-meta-app-secret"

# Shared secret you choose and enter in the Meta App Dashboard webhook config
# (used only for the one-time GET verification handshake)
WHATSAPP_VERIFY_TOKEN="choose-a-random-string"

# Anthropic API key for the AI agent replies
ANTHROPIC_API_KEY="sk-ant-..."
