# PostgreSQL connection string. With Neon (or another pooled/serverless
# Postgres), use the POOLED connection string here — it's what the running
# app uses to talk to the database.
DATABASE_URL="postgresql://user:password@localhost:5432/app_funnels"

# Optional but recommended with Neon: the DIRECT (unpooled) connection
# string, used only for `prisma migrate deploy` during the build. Migrations
# hold a postgres advisory lock that needs a stable session, which a pooled
# connection (pgbouncer in transaction mode) can't guarantee — without this,
# deploys can fail with "Error P1002: Timed out trying to acquire a postgres
# advisory lock". In Neon: dashboard > Connection Details > turn off "Pooled
# connection" to get this string. Falls back to DATABASE_URL if unset.
DIRECT_URL="postgresql://user:password@localhost:5432/app_funnels"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# 32-byte (base64) key used to encrypt WhatsApp access tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# Meta app used to verify webhook signatures (App Dashboard > Settings > Basic > App Secret)
META_APP_SECRET="your-meta-app-secret"

# Same Meta App's numeric App ID (App Dashboard > Settings > Basic > App ID)
# — needed to upload a template's header image to Meta's Resumable Upload
# API when creating a template with an image header.
META_APP_ID="your-meta-app-id"

# Shared secret you choose and enter in the Meta App Dashboard webhook config
# (used only for the one-time GET verification handshake)
WHATSAPP_VERIFY_TOKEN="choose-a-random-string"

# Set this in Vercel's project env vars (Production) so Vercel Cron can call
# /api/cron/metric-alerts — Vercel automatically sends it as
# `Authorization: Bearer $CRON_SECRET` on cron-triggered requests, and the
# route checks it. Generate with: openssl rand -base64 32
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Anthropic API key for the AI agent replies
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI API key — used for voice notes (transcribing an inbound WhatsApp
# voice note with Whisper, and synthesizing the agent's reply as one with
# TTS when the customer spoke first) and for generating each website's
# hero photo (see lib/websiteHeroImage.ts — gpt-image-1, "medium" quality,
# once per "Generar"/"Regenerar todo" click). Get one at platform.openai.com
# — separate account/billing from Anthropic. Optional: if unset, the agent
# still works normally by text (just no voice notes), and generated
# websites just render without a hero photo unless the business uploads
# its own via "Multimedia".
OPENAI_API_KEY="sk-..."

# Optional: the agency's own login email. When set, every new client that
# self-registers via /register also grants this account an ADMIN membership
# on their business — so the agency sees every client from one dashboard.
AGENCY_ADMIN_EMAIL="you@funnelslabs.co"

# Mercado Pago private access token (Panel de desarrolladores > Credenciales
# de producción). Used to look up the real payer + status for a webhook
# notification (which only sends an id) before provisioning an account —
# see src/app/api/webhooks/mercadopago/route.ts.
MERCADOPAGO_ACCESS_TOKEN="your-mercadopago-access-token"

# Shared token Hotmart sends on every webhook call (set when you configure
# the webhook in Hotmart's dashboard: Ferramentas > Webhook). Used to
# provision a client's account automatically once a purchase is approved —
# see src/app/api/webhooks/hotmart/route.ts.
HOTMART_HOTTOK="your-hotmart-hottok"

# Domain used in the account-activation email link sent after a Hotmart
# purchase (e.g. "agente.funnelslabs.app" or "app-funnels.vercel.app").
# Defaults to funnelslabs.app if unset.
APP_HOST="agente.funnelslabs.app"

# Vercel Blob storage token — used to host chat attachments (images, voice
# notes, documents, video) sent or received in a conversation. In Vercel:
# Storage tab > Create Database > Blob, then copy the token it generates
# (or run `vercel env pull` locally). Without it, sending/receiving a file
# in the CRM chat fails; plain text messages are unaffected.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Google Apps Script Web App URL — powers two things: (1) appends a row to
# a Google Sheet on every new client registration, for remarketing, and
# (2) sends the "forgot password" email. One script, one deployment, one
# URL. See PROJECT_STATE.md for the Apps Script snippet and deployment
# steps. If unset, both features silently no-op (never block the request
# itself) — registration still works, and "forgot password" still shows
# its generic success message, it just doesn't send anything.
GOOGLE_APPS_SCRIPT_WEBHOOK_URL="https://script.google.com/macros/s/xxx/exec"
